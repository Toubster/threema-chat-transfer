{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:threema-chat-transfer:schema:compat:v1",
 "title": "Compatibility allow-lists and device-run records, v1",
 "description": "compat/ios.json (kind ios), compat/threema-ios.json (kind threema-ios), compat/android.json (kind android), compat/records/ios/<build>.json (kind ios-record). Bundled in the app; never fetched over the network (DESIGN §6). v1 allows restores only for status 'verified'.",
 "oneOf": [
  {
   "$ref": "#/$defs/ios"
  },
  {
   "$ref": "#/$defs/threema_ios"
  },
  {
   "$ref": "#/$defs/android"
  },
  {
   "$ref": "#/$defs/record"
  }
 ],
 "$defs": {
  "ios": {
   "type": "object",
   "properties": {
    "schema": {
     "const": 1
    },
    "kind": {
     "const": "ios"
    },
    "builds": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "build": {
        "type": "string",
        "pattern": "^[0-9]{2}[A-Z][0-9]{1,5}[a-z]?$"
       },
       "ios": {
        "$ref": "urn:threema-chat-transfer:schema:events:v1#/$defs/version"
       },
       "status": {
        "enum": [
         "verified",
         "static_checked",
         "unknown",
         "blocked"
        ]
       },
       "verified_on": {
        "type": [
         "string",
         "null"
        ],
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
       },
       "evidence": {
        "type": [
         "string",
         "null"
        ],
        "pattern": "^records/ios/[0-9A-Za-z]{4,10}\\.json$"
       },
       "expected_notes": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^N_[A-Z0-9_]{2,60}$"
        },
        "uniqueItems": true
       },
       "min_app": {
        "$ref": "urn:threema-chat-transfer:schema:events:v1#/$defs/version"
       },
       "comment_code": {
        "type": [
         "string",
         "null"
        ],
        "pattern": "^[a-z][a-z0-9_]{0,47}$",
        "description": "machine-readable reason, e.g. pending_device_evidence, acceptance_partial"
       }
      },
      "required": [
       "build",
       "ios",
       "status",
       "expected_notes",
       "min_app"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "schema",
    "kind",
    "builds"
   ],
   "additionalProperties": false
  },
  "threema_ios": {
   "type": "object",
   "properties": {
    "schema": {
     "const": 1
    },
    "kind": {
     "const": "threema-ios"
    },
    "models": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^V[0-9]{1,3}$"
       },
       "version_hashes_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "sha256 over json.dumps(NSStoreModelVersionHashes as base64, sort_keys=True)"
       },
       "version_identifiers": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^[A-Za-z0-9_]{1,40}$"
        }
       },
       "momd": {
        "type": "string",
        "pattern": "^models/V[0-9]{1,3}/ThreemaData\\.momd$"
       },
       "source_commit": {
        "type": "string",
        "pattern": "^([0-9a-f]{7,40}|<pinned>)$"
       },
       "importer_mapping": {
        "type": "string",
        "pattern": "^v[0-9]{1,3}$"
       },
       "status": {
        "enum": [
         "verified",
         "unknown",
         "blocked"
        ]
       },
       "app_versions": {
        "type": "object",
        "properties": {
         "min": {
          "$ref": "urn:threema-chat-transfer:schema:events:v1#/$defs/version"
         },
         "max_tested": {
          "$ref": "urn:threema-chat-transfer:schema:events:v1#/$defs/version"
         }
        },
        "required": [
         "min"
        ],
        "additionalProperties": false
       },
       "blocked_app_versions": {
        "type": "array",
        "items": {
         "$ref": "urn:threema-chat-transfer:schema:events:v1#/$defs/version"
        }
       }
      },
      "required": [
       "id",
       "version_hashes_sha256",
       "momd",
       "importer_mapping",
       "status",
       "app_versions",
       "blocked_app_versions"
      ],
      "additionalProperties": false
     }
    },
    "variants_allowed": {
     "type": "array",
     "items": {
      "enum": [
       "ch.threema.iapp"
      ]
     }
    }
   },
   "required": [
    "schema",
    "kind",
    "models",
    "variants_allowed"
   ],
   "additionalProperties": false
  },
  "android": {
   "type": "object",
   "properties": {
    "schema": {
     "const": 1
    },
    "kind": {
     "const": "android"
    },
    "verified_formats": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     }
    },
    "max_known_format": {
     "type": "integer",
     "minimum": 1
    }
   },
   "required": [
    "schema",
    "kind",
    "verified_formats"
   ],
   "additionalProperties": false
  },
  "record": {
   "type": "object",
   "properties": {
    "schema": {
     "const": 1
    },
    "kind": {
     "const": "ios-record"
    },
    "build": {
     "type": "string",
     "pattern": "^[0-9]{2}[A-Z][0-9]{1,5}[a-z]?$"
    },
    "ios": {
     "$ref": "urn:threema-chat-transfer:schema:events:v1#/$defs/version"
    },
    "product_type": {
     "type": "string",
     "pattern": "^(iPhone|iPad|iPod)[0-9]{1,3},[0-9]{1,2}$"
    },
    "device_class": {
     "enum": [
      "spare",
      "maintainer"
     ],
     "description": "spare = replacement iPhone (DESIGN §13.4); maintainer = DESIGN §20 D6"
    },
    "runs": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "kind": {
        "enum": [
         "C0",
         "C1a",
         "C3",
         "R1",
         "R3",
         "negative",
         "large",
         "offline_setup",
         "language",
         "app_run"
        ],
        "description": "C0/C1a/C3/R1/R3: COMPAT-POLICY.md §1.1; app_run: a wizard run of an app build on the device that may stop before the restore (guard or device refusal)"
       },
       "date": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
       },
       "app_version": {
        "$ref": "urn:threema-chat-transfer:schema:events:v1#/$defs/version"
       },
       "verdict": {
        "anyOf": [
         {
          "enum": [
           "setup_full",
           "data_keychain",
           "data",
           "threema_only",
           "restore_state",
           "needs_answer",
           "ok_with_notes",
           "ok"
          ]
         },
         {
          "enum": [
           "red_expected",
           "pass",
           "fail",
           "stopped_before_restore"
          ]
         }
        ]
       },
       "waivers": {
        "const": 0
       },
       "notes": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^N_[A-Z0-9_]{2,60}$"
        }
       },
       "counts": {
        "type": "object",
        "propertyNames": {
         "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "additionalProperties": {
         "type": "integer",
         "minimum": 0
        },
        "description": "counts only, no identifiers (DESIGN §13.4)"
       }
      },
      "required": [
       "kind",
       "date",
       "verdict"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "schema",
    "kind",
    "build",
    "ios",
    "runs"
   ],
   "additionalProperties": false
  }
 }
}
