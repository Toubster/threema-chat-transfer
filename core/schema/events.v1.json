{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:threema-chat-transfer:schema:events:v1",
 "title": "tmcore stdout events, protocol v1",
 "description": "One JSON object per stdout line (UTF-8, <= 64 KiB, flushed). Producer (tmcore) is strict: only the fields declared here. Consumer (the app) is tolerant: it ignores unknown fields and maps unknown codes to F-INTERNAL. Exactly one 'result' per process, always the last event; 'seq' starts at 1 and has no gaps. DESIGN §5.",
 "x-protocol": 1,
 "x-commands": [
  "version",
  "selftest",
  "host-check",
  "android-inspect",
  "android-normalize",
  "device-watch",
  "device-status",
  "encryption-enable",
  "backup",
  "prepare",
  "restore",
  "postcheck",
  "rollback-threema",
  "session-status",
  "diag-report",
  "cleanup"
 ],
 "x-phases": {
  "version": [],
  "session-status": [],
  "device-watch": [],
  "selftest": [
   "imports",
   "bundle",
   "netguard"
  ],
  "host-check": [
   "checks"
  ],
  "android-inspect": [
   "inspect"
  ],
  "android-normalize": [
   "read",
   "media",
   "verify"
  ],
  "device-status": [
   "read"
  ],
  "encryption-enable": [
   "confirm_on_device"
  ],
  "backup": [
   "backup",
   "checks"
  ],
  "prepare": [
   "extract",
   "import",
   "count",
   "build",
   "verify"
  ],
  "restore": [
   "guards",
   "send",
   "reboot"
  ],
  "rollback-threema": [
   "build",
   "guards",
   "send",
   "reboot"
  ],
  "postcheck": [
   "threema",
   "compare",
   "verdict"
  ],
  "diag-report": [
   "collect"
  ],
  "cleanup": [
   "delete"
  ]
 },
 "oneOf": [
  {
   "$ref": "#/$defs/hello"
  },
  {
   "$ref": "#/$defs/phaseEvent"
  },
  {
   "$ref": "#/$defs/progress"
  },
  {
   "$ref": "#/$defs/check"
  },
  {
   "$ref": "#/$defs/prompt"
  },
  {
   "$ref": "#/$defs/retry"
  },
  {
   "$ref": "#/$defs/device"
  },
  {
   "$ref": "#/$defs/critical"
  },
  {
   "$ref": "#/$defs/note"
  },
  {
   "$ref": "#/$defs/result"
  }
 ],
 "$defs": {
  "timestamp": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
   "description": "RFC 3339, UTC, 'Z' suffix"
  },
  "code": {
   "type": "string",
   "pattern": "^[EWNR]_[A-Z0-9_]{2,60}$",
   "description": "a code from core/schema/codes.v1.json"
  },
  "hash": {
   "type": "string",
   "pattern": "^h:[0-9a-f]{8}$",
   "description": "'h:' + first 8 hex of HMAC-SHA256(session salt, value). Never the value itself."
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]{1,4}(\\.[0-9]{1,4}){0,3}([-+.][0-9A-Za-z.]{1,20})?$"
  },
  "command": {
   "enum": [
    "version",
    "selftest",
    "host-check",
    "android-inspect",
    "android-normalize",
    "device-watch",
    "device-status",
    "encryption-enable",
    "backup",
    "prepare",
    "restore",
    "postcheck",
    "rollback-threema",
    "session-status",
    "diag-report",
    "cleanup"
   ]
  },
  "phase": {
   "enum": [
    "backup",
    "build",
    "bundle",
    "checks",
    "collect",
    "compare",
    "confirm_on_device",
    "count",
    "delete",
    "extract",
    "guards",
    "import",
    "imports",
    "inspect",
    "media",
    "netguard",
    "read",
    "reboot",
    "send",
    "threema",
    "verdict",
    "verify"
   ]
  },
  "safeString": {
   "description": "The only strings allowed in event data: enums/tokens, codes, hashes, timestamps, public version numbers, iOS builds, device model identifiers, model IDs, screen IDs, session-relative file keys and sha256 digests of public bundle files. No free text, no paths, no names (DESIGN §5.2).",
   "anyOf": [
    {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,47}$",
     "title": "token"
    },
    {
     "type": "string",
     "pattern": "^[EWNR]_[A-Z0-9_]{2,60}$",
     "title": "code"
    },
    {
     "type": "string",
     "pattern": "^h:[0-9a-f]{8}$",
     "title": "hash"
    },
    {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
     "title": "timestamp"
    },
    {
     "type": "string",
     "pattern": "^[0-9]{1,4}(\\.[0-9]{1,4}){0,3}([-+.][0-9A-Za-z.]{1,20})?$",
     "title": "version"
    },
    {
     "type": "string",
     "pattern": "^[0-9]{2}[A-Z][0-9]{1,5}[a-z]?$",
     "title": "ios_build"
    },
    {
     "type": "string",
     "pattern": "^(iPhone|iPad|iPod)[0-9]{1,3},[0-9]{1,2}$",
     "title": "product_type"
    },
    {
     "type": "string",
     "pattern": "^V[0-9]{1,3}$",
     "title": "model_id"
    },
    {
     "type": "string",
     "pattern": "^(S[0-9]{2}[a-z]?|F-[A-Z0-9-]{2,40})$",
     "title": "screen"
    },
    {
     "type": "string",
     "pattern": "^(android|ios|work|reports|logs|diag)/[a-z0-9_.-]{1,60}(/[a-z0-9_.-]{1,60}){0,3}$",
     "title": "session_file"
    },
    {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$",
     "title": "sha256"
    }
   ]
  },
  "safeValue": {
   "anyOf": [
    {
     "type": [
      "number",
      "boolean",
      "null"
     ]
    },
    {
     "$ref": "#/$defs/safeString"
    },
    {
     "type": "array",
     "maxItems": 2000,
     "items": {
      "$ref": "#/$defs/safeValue"
     }
    },
    {
     "$ref": "#/$defs/safeObject"
    }
   ]
  },
  "safeObject": {
   "type": "object",
   "maxProperties": 200,
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]{0,47}$"
   },
   "additionalProperties": {
    "$ref": "#/$defs/safeValue"
   }
  },
  "envelope": {
   "type": "object",
   "required": [
    "v",
    "seq",
    "ts",
    "cmd",
    "type"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "$ref": "#/$defs/timestamp"
    },
    "cmd": {
     "$ref": "#/$defs/command"
    },
    "type": {
     "enum": [
      "hello",
      "phase",
      "progress",
      "check",
      "prompt",
      "retry",
      "device",
      "critical",
      "note",
      "result"
     ]
    }
   }
  },
  "hello": {
   "type": "object",
   "required": [
    "v",
    "seq",
    "ts",
    "cmd",
    "type",
    "engine_version",
    "protocol",
    "pymobiledevice3",
    "importer_version",
    "models",
    "compat_digest"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "$ref": "#/$defs/timestamp"
    },
    "cmd": {
     "$ref": "#/$defs/command"
    },
    "type": {
     "const": "hello"
    },
    "engine_version": {
     "$ref": "#/$defs/version"
    },
    "protocol": {
     "const": 1
    },
    "pymobiledevice3": {
     "$ref": "#/$defs/version"
    },
    "importer_version": {
     "$ref": "#/$defs/version"
    },
    "models": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^V[0-9]{1,3}$"
     },
     "uniqueItems": true
    },
    "compat_digest": {
     "$ref": "#/$defs/hash"
    },
    "fake_device": {
     "type": "boolean",
     "description": "true when started with --fake-device (CI, demo mode)"
    }
   },
   "additionalProperties": false
  },
  "phaseEvent": {
   "type": "object",
   "required": [
    "v",
    "seq",
    "ts",
    "cmd",
    "type",
    "phase",
    "index",
    "count"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "$ref": "#/$defs/timestamp"
    },
    "cmd": {
     "$ref": "#/$defs/command"
    },
    "type": {
     "const": "phase"
    },
    "phase": {
     "$ref": "#/$defs/phase"
    },
    "index": {
     "type": "integer",
     "minimum": 1
    },
    "count": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "progress": {
   "type": "object",
   "required": [
    "v",
    "seq",
    "ts",
    "cmd",
    "type",
    "phase",
    "pct",
    "done",
    "total",
    "unit"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "$ref": "#/$defs/timestamp"
    },
    "cmd": {
     "$ref": "#/$defs/command"
    },
    "type": {
     "const": "progress"
    },
    "phase": {
     "$ref": "#/$defs/phase"
    },
    "pct": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    },
    "done": {
     "type": "integer",
     "minimum": 0
    },
    "total": {
     "type": "integer",
     "minimum": 0
    },
    "unit": {
     "enum": [
      "bytes",
      "files",
      "items"
     ]
    },
    "eta_s": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "check": {
   "type": "object",
   "required": [
    "v",
    "seq",
    "ts",
    "cmd",
    "type",
    "id",
    "status"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "$ref": "#/$defs/timestamp"
    },
    "cmd": {
     "$ref": "#/$defs/command"
    },
    "type": {
     "const": "check"
    },
    "id": {
     "enum": [
      "airplane",
      "android_file",
      "android_format",
      "android_media",
      "android_password",
      "android_text",
      "arch",
      "battery",
      "buddy_answer",
      "bundle_hashes",
      "compat_ios",
      "coredata_open",
      "dcim_unchanged",
      "device",
      "duplicate_chat",
      "encryption",
      "extract",
      "filevault",
      "findmy",
      "free_space",
      "freeze",
      "freshness",
      "fs_apfs",
      "identity",
      "import",
      "ios_unchanged",
      "iphone_space",
      "keychain_items",
      "macos",
      "managed",
      "modules",
      "netguard",
      "p2_verify_import",
      "p3_payload",
      "p4_strict",
      "password",
      "photos_limit",
      "post_after_restore",
      "power",
      "purplebuddy",
      "restoreset",
      "rollback_allowed",
      "rollback_window",
      "set_integrity",
      "threema_answer",
      "threema_model",
      "threema_retention",
      "threema_setup",
      "threema_variant",
      "verify_import",
      "verify_restoreset"
     ]
    },
    "status": {
     "enum": [
      "pass",
      "warn",
      "fail",
      "skip"
     ]
    },
    "code": {
     "$ref": "#/$defs/code"
    },
    "data": {
     "$ref": "#/$defs/safeObject",
     "description": "numbers and enums only"
    }
   },
   "additionalProperties": false
  },
  "prompt": {
   "type": "object",
   "required": [
    "v",
    "seq",
    "ts",
    "cmd",
    "type",
    "kind",
    "active"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "$ref": "#/$defs/timestamp"
    },
    "cmd": {
     "$ref": "#/$defs/command"
    },
    "type": {
     "const": "prompt"
    },
    "kind": {
     "enum": [
      "unlock_device",
      "trust_device",
      "passcode_on_device",
      "keep_cable"
     ]
    },
    "active": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "retry": {
   "type": "object",
   "required": [
    "v",
    "seq",
    "ts",
    "cmd",
    "type",
    "reason",
    "attempt",
    "max",
    "wait_s"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "$ref": "#/$defs/timestamp"
    },
    "cmd": {
     "$ref": "#/$defs/command"
    },
    "type": {
     "const": "retry"
    },
    "reason": {
     "$ref": "#/$defs/code"
    },
    "attempt": {
     "type": "integer",
     "minimum": 1
    },
    "max": {
     "type": "integer",
     "minimum": 1
    },
    "wait_s": {
     "type": "number",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "device": {
   "type": "object",
   "required": [
    "v",
    "seq",
    "ts",
    "cmd",
    "type",
    "state"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "$ref": "#/$defs/timestamp"
    },
    "cmd": {
     "$ref": "#/$defs/command"
    },
    "type": {
     "const": "device"
    },
    "state": {
     "enum": [
      "none",
      "locked",
      "untrusted",
      "ready",
      "multiple",
      "disconnected"
     ]
    },
    "device": {
     "$ref": "#/$defs/hash"
    },
    "product_type": {
     "type": "string",
     "pattern": "^(iPhone|iPad|iPod)[0-9]{1,3},[0-9]{1,2}$"
    }
   },
   "additionalProperties": false
  },
  "critical": {
   "type": "object",
   "required": [
    "v",
    "seq",
    "ts",
    "cmd",
    "type",
    "on"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "$ref": "#/$defs/timestamp"
    },
    "cmd": {
     "$ref": "#/$defs/command"
    },
    "type": {
     "const": "critical"
    },
    "on": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "note": {
   "type": "object",
   "required": [
    "v",
    "seq",
    "ts",
    "cmd",
    "type",
    "code"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "ts": {
     "$ref": "#/$defs/timestamp"
    },
    "cmd": {
     "$ref": "#/$defs/command"
    },
    "type": {
     "const": "note"
    },
    "code": {
     "type": "string",
     "pattern": "^[WN]_[A-Z0-9_]{2,60}$"
    },
    "data": {
     "$ref": "#/$defs/safeObject"
    }
   },
   "additionalProperties": false
  },
  "result_ok_version": {
   "type": "object",
   "properties": {
    "engine_version": {
     "$ref": "#/$defs/version"
    },
    "protocol": {
     "const": 1
    },
    "pymobiledevice3": {
     "$ref": "#/$defs/version"
    },
    "importer_version": {
     "$ref": "#/$defs/version"
    },
    "python": {
     "$ref": "#/$defs/version"
    },
    "models": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^V[0-9]{1,3}$"
     }
    },
    "model_sha256": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "model": {
        "type": "string",
        "pattern": "^V[0-9]{1,3}$"
       },
       "sha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
       }
      },
      "required": [
       "model",
       "sha256"
      ],
      "additionalProperties": false
     }
    },
    "importer_sha256": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compat_sha256": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compat_digest": {
     "$ref": "#/$defs/hash"
    }
   },
   "required": [
    "engine_version",
    "protocol",
    "importer_version",
    "models"
   ],
   "additionalProperties": false
  },
  "result_ok_selftest": {
   "type": "object",
   "properties": {
    "modules_ok": {
     "type": "integer",
     "minimum": 0
    },
    "bundle_ok": {
     "type": "boolean"
    },
    "netguard": {
     "type": "boolean"
    },
    "python": {
     "$ref": "#/$defs/version"
    }
   },
   "required": [
    "modules_ok",
    "bundle_ok",
    "netguard"
   ],
   "additionalProperties": false
  },
  "result_ok_host_check": {
   "type": "object",
   "properties": {
    "macos": {
     "$ref": "#/$defs/version"
    },
    "arch": {
     "enum": [
      "arm64",
      "x86_64"
     ]
    },
    "fs": {
     "enum": [
      "apfs",
      "hfs",
      "exfat",
      "msdos",
      "smbfs",
      "nfs",
      "other"
     ]
    },
    "free_bytes": {
     "type": "integer",
     "minimum": 0
    },
    "need_bytes": {
     "type": "integer",
     "minimum": 0
    },
    "power": {
     "enum": [
      "ac",
      "battery",
      "unknown"
     ]
    },
    "battery_pct": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "filevault": {
     "type": "boolean"
    }
   },
   "required": [
    "macos",
    "arch",
    "fs",
    "free_bytes",
    "power",
    "filevault"
   ],
   "additionalProperties": false
  },
  "result_ok_android_inspect": {
   "type": "object",
   "properties": {
    "files": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "ref": {
        "type": "integer",
        "minimum": 0,
        "description": "index of the file in argv (user's choice)"
       },
       "kind": {
        "enum": [
         "full",
         "text",
         "media",
         "incomplete",
         "unknown"
        ]
       },
       "format_version": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "created_at": {
        "anyOf": [
         {
          "$ref": "#/$defs/timestamp"
         },
         {
          "type": "null"
         }
        ]
       },
       "bytes": {
        "type": "integer",
        "minimum": 0
       },
       "has_media": {
        "type": "boolean"
       },
       "encrypted": {
        "type": "boolean"
       }
      },
      "required": [
       "ref",
       "kind",
       "bytes",
       "has_media"
      ],
      "additionalProperties": false
     }
    },
    "plan": {
     "enum": [
      "single",
      "text_plus_media",
      "none"
     ]
    },
    "text_ref": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "media_refs": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "required": [
    "files",
    "plan",
    "media_refs"
   ],
   "additionalProperties": false
  },
  "result_ok_android_normalize": {
   "type": "object",
   "properties": {
    "chats": {
     "type": "integer",
     "minimum": 0
    },
    "groups": {
     "type": "integer",
     "minimum": 0
    },
    "messages": {
     "type": "integer",
     "minimum": 0
    },
    "media_present": {
     "type": "integer",
     "minimum": 0
    },
    "media_total": {
     "type": "integer",
     "minimum": 0
    },
    "polls": {
     "type": "integer",
     "minimum": 0
    },
    "own_unsent_as_sent": {
     "type": "integer",
     "minimum": 0
    },
    "missing_key_senders": {
