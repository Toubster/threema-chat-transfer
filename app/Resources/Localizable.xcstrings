    "code.E_IOS_UNKNOWN.body" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese iOS-Version ({ios_version}, {ios_build}) haben wir noch nicht geprüft. Damit Ihr iPhone sicher bleibt, überträgt {App} damit nichts. Neue iOS-Versionen prüfen wir meist innerhalb von zwei Wochen. Sie können den Android-Teil schon vorbereiten und später hier weitermachen. Bitte installieren Sie bis dahin kein weiteres Update."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We have not tested this iOS version ({ios_version}, {ios_build}) yet. To keep your iPhone safe, {App} will not transfer anything with it. We usually test new iOS versions within two weeks. You can already prepare the Android part and continue here later. Please do not install another update until then."
          }
        }
      }
    },
    "code.E_IOS_UNKNOWN.title" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
