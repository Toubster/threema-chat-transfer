        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare the Android part"
          }
        }
      }
    },
    "code.E_IOS_BLOCKED.body" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese iOS-Version ({ios_version}, {ios_build}) wurde die Freigabe zurückgezogen. Damit Ihr iPhone sicher bleibt, überträgt {App} damit nichts. Bitte warten Sie auf eine neue Version von {App}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support for this iOS version ({ios_version}, {ios_build}) was withdrawn. To keep your iPhone safe, {App} will not transfer anything with it. Please wait for a new version of {App}."
          }
        }
      }
    },
    "code.E_IOS_BLOCKED.title" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese iOS-Version ist gesperrt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iOS version is blocked"
          }
        }
      }
    },
    "code.E_IOS_CHANGED.action" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück zu „iPhone kurz prüfen“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back to “Quick iPhone check”"
          }
        }
      }
    },
    "code.E_IOS_CHANGED.body" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit der Sicherung hat sich die iOS-Version geändert. Bitte ab „iPhone kurz prüfen“ neu beginnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iOS version changed since the backup. Please start again from “Quick iPhone check”."
          }
