      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit der ersten Sicherung sind mehr als 6 Stunden vergangen. {App} setzt Threema deshalb nicht mehr zurück. Der sichere Weg zurück ist Ihre Apple-Sicherung von heute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than 6 hours have passed since the first backup, so {App} no longer resets Threema. The safe way back is today’s Apple backup."
          }
        }
      }
