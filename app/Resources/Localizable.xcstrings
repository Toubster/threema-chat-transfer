    "code.E_IOS_BLOCKED.action" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android-Teil vorbereiten"
          }
