    "s10a.text" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ihr iPhone hat noch kein Sicherungs-Passwort.** {App} legt jetzt eines fest – genau dieses schützt ab jetzt Ihre Sicherungen. Für den Umzug müssen die Sicherungen auf diesem Mac verschlüsselt sein, denn nur dann enthalten sie alle Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Your iPhone has no backup password yet.** {App} sets one now – exactly this one protects your backups from now on. For the move, the backups on this Mac must be encrypted, because only then do they contain all data."
          }
        }
      }
    },
    "s10b.choice" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kennen Sie dieses Passwort?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you know this password?"
          }
        }
      }
    },
    "s10b.choice.known" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kenne das Passwort"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I know the password"
          }
        }
      }
    },
    "s10b.choice.unknown" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich weiß es nicht / habe nie eins festgelegt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I don't know it / never set one"
          }
        }
      }
    },
    "s10b.field" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwort für iPhone-Sicherungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Password for iPhone backups"
          }
        }
      }
    },
    "s10b.finder_note" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verschlüsselung ist inzwischen eingeschaltet, wahrscheinlich weil Sie eben im Finder „Lokales Backup verschlüsseln“ gewählt haben. Dann schützt das Passwort, das Sie dort festgelegt haben, Ihre Sicherungen. Geben Sie dieses Passwort ein. Ein Passwort, das {App} Ihnen vorher gezeigt hat, gilt nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encryption is now turned on, probably because you just chose “Encrypt local backup” in Finder. Then the password you set there protects your backups. Enter that password. A password {App} showed you before does not apply."
          }
        }
      }
    },
    "s10b.known.check" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} prüft das Passwort gleich nach der ersten Sicherung. Ist es falsch, sagt Ihnen die App das nach wenigen Minuten. Am iPhone wird dabei nichts verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} checks the password right after the first backup. If it is wrong, the app tells you within a few minutes. Nothing on the iPhone is changed by this."
          }
        }
      }
    },
    "s10b.text" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr iPhone verschlüsselt jede Sicherung auf einem Computer mit diesem gespeicherten Passwort. {App} kann die Sicherung nur mit genau diesem Passwort öffnen. **Ein neues oder beliebiges Passwort funktioniert hier nicht.**"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone encrypts every backup on a computer with this stored password. {App} can open the backup only with exactly this password. **A new or made-up password does not work here.**"
          }
        }
      }
    },
    "s11.btn" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherung starten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start backup"
          }
        }
      }
    },
    "s11.item.1" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema schließen: vom unteren Rand nach oben wischen und Threema nach oben wegschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close Threema: swipe up from the bottom edge and swipe Threema away."
          }
        }
      }
    },
    "s11.item.2" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls Sie eine Apple Watch haben: Watch ausschalten. Bluetooth über Einstellungen → Bluetooth ausschalten (nicht nur im Kontrollzentrum)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have an Apple Watch: turn the Watch off. Turn Bluetooth off in Settings → Bluetooth (not just in Control Center)."
          }
        }
      }
    },
    "s11.item.3" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flugmodus an. Prüfen Sie im Kontrollzentrum, dass auch WLAN aus ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airplane mode on. Check in Control Center that Wi-Fi is off too."
          }
        }
      }
    },
    "s11.item.4" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone entsperrt am Kabel liegen lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave the iPhone unlocked and connected."
          }
        }
      }
    },
    "s11.text" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab diesem Schritt bleibt Ihr iPhone bis zum Ende offline und unbenutzt (etwa 30 bis 60 Minuten). Fotos, Nachrichten und Einstellungen aus dieser Zeit würden sonst gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From this step until the end your iPhone stays offline and unused (about 30 to 60 minutes). Photos, messages and settings from this time would otherwise be deleted."
          }
        }
      }
    },
    "s11.title" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab jetzt läuft die Zeit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clock starts now"
          }
        }
      }
    },
    "s12.text" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das dauert etwa {min} Minuten. Lassen Sie das Kabel stecken. Bricht die Sicherung nach wenigen Sekunden ab, startet {App} sie automatisch neu. Auch das ist normal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This takes about {min} minutes. Keep the cable connected. If the backup stops after a few seconds, {App} restarts it automatically. That is normal too."
          }
        }
      }
    },
