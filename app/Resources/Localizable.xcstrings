    "s08.item.1" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS-Updates aus: Einstellungen → Allgemein → Softwareupdate → Automatische Updates → alles aus. Bis zum Ende kein Update installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS updates off: Settings → General → Software Update → Automatic Updates → all off. Do not install any update until the end."
          }
        }
      }
    },
    "s08.item.2" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Updates aus: Einstellungen → Apps → App Store → App-Updates aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App updates off: Settings → Apps → App Store → App Updates off."
          }
        }
      }
    },
    "s08.item.3" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wo ist?“ ausschalten, bitte zu Hause: Zuerst Einstellungen → Face ID & Code → „Schutz für gestohlene Geräte“ aus (falls an; unterwegs verzögert das iPhone diesen Schritt um eine Stunde). Dann Einstellungen → [Ihr Name] → Wo ist? → „Mein iPhone suchen“ aus (Apple-Account-Passwort nötig)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off Find My, preferably at home: first Settings → Face ID & Passcode → “Stolen Device Protection” off (if on; away from home the iPhone delays this by one hour). Then Settings → [your name] → Find My → “Find My iPhone” off (Apple Account password needed)."
          }
        }
      }
    },
    "s08.item.4" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akku mindestens 50 % oder am Ladekabel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery at least 50 % or charging."
          }
        }
      }
    },
    "s09.check" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe heute eine Apple-Sicherung erstellt:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I made an Apple backup today:"
          }
        }
      }
    },
    "s09.finder" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherung auf diesem Mac (ohne iCloud-Speicher): Finder → Ihr iPhone → Allgemein → „Lokales Backup verschlüsseln“ → „Backup jetzt erstellen“. War das Häkchen noch aus, legen Sie dabei ein neues Passwort für iPhone-Sicherungen auf dem Mac fest: Notieren Sie es, {App} fragt gleich danach. War es schon an, gilt Ihr bisheriges Passwort. Danach „Backups verwalten …“ → Rechtsklick auf das neue Backup → „Archivieren“. Braucht zusätzlichen Platz auf diesem Mac, etwa so viel, wie auf dem iPhone belegt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup on this Mac (no iCloud storage needed): Finder → your iPhone → General → “Encrypt local backup” → “Back Up Now”. If the box was still unticked, you set a new password for iPhone backups on the Mac there: write it down, {App} asks for it next. If it was already ticked, your existing password applies. Then “Manage Backups …” → right-click the new backup → “Archive”. Needs extra space on this Mac, about as much as is used on the iPhone."
          }
        }
      }
    },
    "s09.icloud" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Backup (einfach, kein extra Passwort): Einstellungen → [Ihr Name] → iCloud → iCloud-Backup → „Jetzt sichern“. Warten Sie, bis „Letztes Backup: gerade eben“ dasteht. Dafür braucht Ihr iCloud-Speicher genug Platz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Backup (easy, no extra password): Settings → [your name] → iCloud → iCloud Backup → “Back Up Now”. Wait until it says “Last backup: just now”. Your iCloud storage needs enough space for this."
          }
        }
      }
    },
    "s09.option.finder" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
