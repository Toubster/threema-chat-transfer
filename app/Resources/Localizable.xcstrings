    "s03.state.untrusted" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte am iPhone „Vertrauen“ tippen"
          }
        },
