  "strings" : {
    "about.disclaimer" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} ist ein inoffizielles, unabhängiges Open-Source-Projekt. Es steht in keiner Verbindung zur Threema AG, zur Apple Inc. oder zur Google LLC und wird von keiner von ihnen unterstützt oder geprüft. Threema ist eine Marke der Threema AG. Apple, iPhone, Finder, iCloud und Apple Pay sind Marken der Apple Inc.; iOS ist eine Marke von Cisco und wird unter Lizenz verwendet. Android ist eine Marke der Google LLC. Die Namen werden nur verwendet, um die Kompatibilität zu beschreiben. Nutzung auf eigene Verantwortung, ohne Gewähr (AGPL-3.0 §§ 15–16)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} is an unofficial, independent open-source project. It is not affiliated with, endorsed or reviewed by Threema AG, Apple Inc. or Google LLC. Threema is a trademark of Threema AG. Apple, iPhone, Finder, iCloud and Apple Pay are trademarks of Apple Inc.; iOS is a trademark of Cisco, used under licence. Android is a trademark of Google LLC. These names are used only to describe compatibility. Use at your own risk, without warranty (AGPL-3.0 §§ 15–16)."
          }
        }
      }
    },
    "about.license" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lizenz: GNU Affero General Public License, Version 3 (AGPL-3.0). Das enthaltene Threema-Datenmodell steht unter AGPL-3.0-only. Der Quellcode liegt offen; wer das Programm verändert und weitergibt, muss den Quellcode ebenfalls offenlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence: GNU Affero General Public License, version 3 (AGPL-3.0). The included Threema data model is licensed AGPL-3.0-only. The source code is public; anyone who changes and passes on the program must publish their source code too."
          }
        }
      }
    },
