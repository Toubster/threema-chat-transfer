    "s00.text" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} überträgt Ihren Threema-Verlauf (Nachrichten, Bilder, Sprachnachrichten, Dateien und Umfragen) aus einer Android-Sicherung auf Ihr iPhone. Alles passiert auf diesem Mac. Ihre Chats werden nicht ins Internet gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} moves your Threema history (messages, pictures, voice messages, files and polls) from an Android backup to your iPhone. Everything happens on this Mac. Your chats are never sent to the internet."
          }
        }
      }
    },
    "s00.title" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema-Chats von Android auf das iPhone übertragen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move your Threema chats from Android to iPhone"
          }
        }
      }
    },
    "s00.unofficial" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inoffiziell – nicht von Threema. Ein unabhängiges Open-Source-Projekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unofficial – not by Threema. An independent open-source project."
          }
        }
      }
    },
    "s00.unofficial.more" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr dazu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More"
          }
        }
      }
    },
    "s00.what.1" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} liest Ihre Android-Sicherung auf diesem Mac und bereitet die Chats für das iPhone vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} reads your Android backup on this Mac and prepares the chats for the iPhone."
          }
        }
      }
    },
    "s00.what.2" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann macht {App} eine Sicherung Ihres iPhones auf diesem Mac und fügt den Verlauf in eine Kopie der Threema-Daten ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then {App} makes a backup of your iPhone on this Mac and adds the history to a copy of the Threema data."
          }
        }
      }
    },
    "s00.what.3" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Ende spielt {App} diese Daten auf Ihr iPhone zurück und vergleicht mit einer zweiten Sicherung, ob außer Threema etwas verändert wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the end, {App} restores this data to your iPhone and compares it with a second backup to see whether anything other than Threema changed."
          }
        }
      }
    },
    "s00.what.4" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} prüft vor jedem Schritt und hält bei jeder Unklarheit an. Es gibt keine Abkürzungen und keine Ausnahmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} checks before every step and stops whenever something is unclear. There are no shortcuts and no exceptions."
          }
        }
      }
    },
    "s00.what.5" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt auf diesem Mac. {App} sendet nichts ins Internet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays on this Mac. {App} sends nothing to the internet."
          }
        }
      }
    },
    "s00.what.title" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So arbeitet {App}"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How {App} works"
          }
        }
      }
    },
    "s01.check" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe das gelesen und nutze {App} auf eigene Verantwortung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have read this and use {App} at my own risk."
          }
        }
      }
    },
    "s01.footer" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema ist eine Marke der Threema AG. Apple und iPhone sind Marken der Apple Inc. {App} steht mit keinem der beiden in Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema is a trademark of Threema AG. Apple and iPhone are trademarks of Apple Inc. {App} is not affiliated with either."
          }
        }
      }
    },
    "s01.p1" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} ist ein inoffizielles, kostenloses Open-Source-Werkzeug. Es stammt weder von Threema noch von Apple, und beide bieten dafür keinen Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} is an unofficial, free, open-source tool. It is not made by Threema or Apple, and neither of them supports it."
          }
        }
      }
    },
    "s01.p2" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Ende spielt {App} Daten auf Ihr iPhone zurück. Dabei setzt das iPhone einige Bereiche auf den Stand von wenigen Minuten vorher zurück: Einstellungen, Mitteilungen, lokale Fotos, SMS/iMessage, Anrufliste, Wallet-Pässe und Tastatur. Was Sie in dieser Zeit am iPhone tun, geht verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the end, {App} restores data to your iPhone. The iPhone resets some areas to how they were a few minutes earlier: settings, notifications, photos stored on the iPhone, SMS/iMessage, call history, Wallet passes and keyboard. Anything you do on the iPhone during that time is lost."
          }
        }
      }
    },
    "s01.p3" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach melden Sie sich mit Ihrem Apple Account neu an und fügen Karten in Apple Pay neu hinzu. Mails, die nur „Auf meinem iPhone“ liegen (POP, lokale Ordner), können verloren gehen. Ihre anderen Apps und gespeicherten Passwörter bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afterwards you sign in to your Apple Account again and add your Apple Pay cards again. Mail stored only “On My iPhone” (POP, local folders) may be lost. Your other apps and saved passwords stay as they are."
          }
        }
      }
    },
    "s01.p4" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} prüft vorher und nachher sehr genau und hält bei jeder Unklarheit an. Ein Restrisiko bleibt. Deshalb legen Sie unterwegs zusätzlich eine Sicherung bei Apple an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} checks very carefully before and after and stops whenever something is unclear. Some risk remains. That is why you will also make a backup with Apple along the way."
          }
        }
      }
    },
