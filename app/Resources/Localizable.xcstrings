      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Gruppennachrichten stammen von Personen, die nie in Ihren Threema-Kontakten waren (Nachrichten: {missing_key_messages}, Personen: {missing_key_senders}, Gruppen: {missing_key_groups}). Damit diese Nachrichten übernommen werden, fügen Sie die Personen gleich in Threema auf dem iPhone als Kontakt hinzu. Wir zeigen Ihnen die Liste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some group messages come from people who were never in your Threema contacts (messages: {missing_key_messages}, people: {missing_key_senders}, groups: {missing_key_groups}). To include these messages, add these people as contacts in Threema on the iPhone in a moment. We will show you the list."
          }
        }
      }
    },
