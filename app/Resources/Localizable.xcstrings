      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein eigenes Passwort nur für Sicherungen Ihres iPhones auf einem Computer. Es ist **nicht** der iPhone-Code, **nicht** das Passwort Ihres Apple Accounts und hat **nichts** mit iCloud-Backups zu tun: Die fragen nie danach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A separate password only for backups of your iPhone on a computer. It is **not** your iPhone passcode, **not** your Apple Account password, and has **nothing** to do with iCloud backups: they never ask for it."
          }
        }
      }
    },
