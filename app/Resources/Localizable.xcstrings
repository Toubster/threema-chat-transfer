    "code.E_THREEMA_ID_MISMATCH.body" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Android-Sicherung gehört zu einer anderen Threema-ID als Threema auf diesem iPhone. Haben Sie die richtige Datei gewählt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Android backup belongs to a different Threema ID than Threema on this iPhone. Did you choose the right file?"
          }
        }
      }
    },
    "code.E_THREEMA_ID_MISMATCH.title" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
