    "code.W_FILEVAULT_OFF.body" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Mac ist nicht verschlüsselt. Während des Umzugs liegen lesbare Kopien Ihrer Chats auf dem Mac, bis Sie am Ende aufräumen. Wir empfehlen, FileVault einzuschalten: Systemeinstellungen → Datenschutz & Sicherheit → FileVault."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Mac is not encrypted. During the move, readable copies of your chats are on this Mac until you clean up at the end. We recommend turning on FileVault: System Settings → Privacy & Security → FileVault."
          }
        }
      }
    },
