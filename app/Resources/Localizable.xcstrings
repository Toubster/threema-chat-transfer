          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Android part is finished. {App} does not transfer anything for your iOS version yet. Please do not install another update and continue here with a new version of {App}."
          }
        }
      }
    },
    "s07.footer" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Threema auf dem iPhone bis zum Schritt „iPhone offline schalten“ normal benutzen. Neue Chats bleiben erhalten, der alte Verlauf wird dazusortiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can use Threema on the iPhone normally until the step “Take your iPhone offline”. New chats are kept; the old history is merged in."
          }
        }
      }
    },
