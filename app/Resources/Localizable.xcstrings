    "s21.now" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte jetzt: Flugmodus **an** lassen, WLAN aus. Das iPhone heute Nacht nicht am WLAN laden, sonst überschreibt ein iCloud-Backup Ihre Sicherung. Nichts am iPhone ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please do this now: keep airplane mode **on**, Wi-Fi off. Do not charge the iPhone on Wi-Fi tonight, otherwise an iCloud backup overwrites your backup. Do not change anything on the iPhone."
          }
        }
      }
    },
    "s21.r1" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr iPhone ist in Ordnung, nur Threema hat den Verlauf nicht richtig übernommen. {App} kann Threema auf den Stand vor der Übertragung zurücksetzen (bis 6 Stunden nach der ersten Sicherung). Dabei gehen auch Einstellungen, lokale Fotos und Tastatur auf diesen Stand zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone is fine; only Threema did not take over the history correctly. {App} can reset Threema to how it was before the transfer (up to 6 hours after the first backup). Settings, photos on the iPhone and keyboard also go back to that point."
          }
        }
      }
    },
    "s21.r1.confirm.text" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPhone startet dabei neu. Threema, Einstellungen, lokale Fotos und Tastatur gehen auf den Stand der ersten Sicherung zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iPhone restarts. Threema, settings, photos on the iPhone and keyboard go back to the state of the first backup."
          }
        }
      }
    },
    "s21.r1.confirm.title" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema jetzt zurücksetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset Threema now?"
          }
        }
      }
    },
    "s21.r2" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außer Threema hat sich etwas verändert: {areas}. Der sichere Weg zurück ist Ihre Apple-Sicherung von heute. Sie können das iPhone auch so lassen und die Bereiche von Hand nachziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something other than Threema changed: {areas}. The safe way back is today's Apple backup. You can also leave the iPhone as it is and fix these areas by hand."
          }
        }
      }
    },
    "s21.r2.guide" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
