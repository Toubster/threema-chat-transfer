    "s09.text" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls etwas schiefgeht, brauchen Sie eine Sicherung, die Apple selbst zurückspielen kann. {App} braucht sie nur im Notfall. Wählen Sie eine:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If something goes wrong, you need a backup that Apple itself can restore. {App} only needs it in an emergency. Choose one:"
          }
        }
      }
    },
