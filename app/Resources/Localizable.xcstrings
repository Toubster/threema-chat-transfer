    "s04.box" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren Sie die Datei (sie beginnt mit „threema-backup_“) auf diesen Mac, am besten mit einem USB-Stick. Cloud-Speicher geht auch, ist für private Chats aber nicht empfohlen. Sie haben schon eine ältere Sicherung mit Medien und eine neuere ohne? Das geht auch, {App} kombiniert sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy the file (its name starts with “threema-backup_”) to this Mac, ideally with a USB stick. Cloud storage also works but is not recommended for private chats. Do you have an older backup with media and a newer one without? That works too, {App} combines them."
          }
        }
      }
    },
    "s04.hint" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machen Sie diese Sicherung erst kurz bevor Sie Threema auf dem iPhone einrichten. Nachrichten, die danach noch auf dem Android-Handy ankommen, fehlen sonst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make this backup shortly before you set up Threema on the iPhone. Messages that arrive on the Android phone afterwards will be missing otherwise."
          }
        }
      }
    },
    "s04.step.1" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Threema auf dem Android-Handy → ⋮ (oben rechts) → „Backups“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Threema on the Android phone → ⋮ (top right) → “Backups”."
          }
        }
      }
    },
    "s04.step.2" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfen Sie, dass Threema Safe eingeschaltet ist und das letzte Safe-Backup von heute stammt. Das Threema-Safe-Passwort brauchen Sie gleich am iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that Threema Safe is on and that the latest Safe backup is from today. You will need the Threema Safe password on the iPhone shortly."
          }
        }
      }
    },
    "s04.step.3" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf „Daten-Backup“ → „Daten-Backup erstellen“. Setzen Sie den Haken bei den Medien (Bilder, Videos, Dateien). Wählen Sie ein Passwort und notieren Sie es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap “Data backup” → “Create data backup”. Tick the option to include media (pictures, videos, files). Choose a password and write it down."
          }
        }
      }
    },
    "s04.step.4" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten Sie, bis die Sicherung fertig ist. Mit vielen Bildern dauert das eine Weile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait until the backup is finished. With many pictures this takes a while."
          }
        }
      }
    },
