    "code.E_GUARD_ROLLBACK_NOT_ALLOWED.action" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnosebericht speichern"
