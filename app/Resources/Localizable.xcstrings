    "code.E_THREEMA_ID_MISMATCH.action" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Sicherung wählen"
          }
        },
        "en" : {
          "stringUnit" : {
