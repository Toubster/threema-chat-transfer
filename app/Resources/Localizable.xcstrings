    "s14.restore" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr iPhone übernimmt dabei einige Bereiche aus der Sicherung von {time}: Einstellungen, Mitteilungen, Fotos auf dem iPhone, SMS/iMessage, Anrufliste, Wallet-Pässe und Tastatur. Diese Sicherung ist erst wenige Minuten alt, und Ihr iPhone war seitdem offline – diese Bereiche bleiben also praktisch, wie sie sind. Das iPhone wird **nicht** gelöscht und **nicht** zurückgesetzt. Ihre anderen Apps und gespeicherten Passwörter bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone takes a few areas from the backup made at {time}: settings, notifications, photos on the iPhone, SMS/iMessage, call history, Wallet passes and keyboard. That backup is only a few minutes old and your iPhone has been offline since, so these areas stay practically as they are. The iPhone is **not** erased and **not** reset. Your other apps and saved passwords stay as they are."
          }
        }
      }
    },
