        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Different Threema ID"
          }
        }
      }
    },
    "code.E_THREEMA_ID_UNREADABLE.action" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Sicherung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New backup"
          }
        }
      }
    },
    "code.E_THREEMA_ID_UNREADABLE.body" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor der Übertragung prüft {App}, ob die Android-Sicherung zur Threema-ID auf diesem iPhone gehört. Diese ID liest {App} aus Ihren Gruppen in Threema. Auf diesem iPhone gibt es dafür keine passende Gruppe, zum Beispiel weil Sie noch in keiner Gruppe sind. Am iPhone wurde nichts verändert. So geht es weiter: Legen Sie in Threema auf dem iPhone eine neue Gruppe an, in der nur Sie selbst sind (eine Notizgruppe), und schließen Sie Threema wieder. Der Flugmodus bleibt dabei an. Klicken Sie dann hier auf „Neue Sicherung“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before the transfer, {App} checks that the Android backup belongs to the Threema ID on this iPhone. {App} reads that ID from your groups in Threema, and this iPhone has no suitable group, for example because you are not in any group yet. Nothing on the iPhone was changed. What to do: in Threema on the iPhone, create a new group with only yourself in it (a note group), then close Threema again. Airplane mode stays on. Then click “New backup” here."
          }
        }
      }
    },
    "code.E_THREEMA_ID_UNREADABLE.title" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema-ID auf dem iPhone nicht lesbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema ID on the iPhone not readable"
          }
        }
      }
    },
