    "code.E_GUARD_ROLLBACK_NOT_ALLOWED.body" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} setzt Threema nur zurück, wenn nach der Übertragung allein Threema betroffen ist. Folgen Sie bitte der Anleitung zu Ihrer Apple-Sicherung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{App} only resets Threema when nothing but Threema was affected by the transfer. Please follow the guide for your Apple backup."
          }
        }
      }
    },
    "code.E_GUARD_ROLLBACK_NOT_ALLOWED.title" : {
      "comment" : "managed by scripts/gen_codes.py (core/schema/codes.v1.json)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurücksetzen nicht möglich"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset not possible"
          }
        }
      }
    },
