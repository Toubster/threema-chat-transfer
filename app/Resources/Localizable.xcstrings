    "s03.text" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie Ihr iPhone mit dem Kabel an diesen Mac an und entsperren Sie es. Erscheint „Diesem Computer vertrauen?“, tippen Sie auf „Vertrauen“ und geben Ihren Code ein. Bitte nur dieses eine iPhone anschließen. {App} liest jetzt nur ein paar Angaben. Am iPhone wird nichts verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your iPhone to this Mac with the cable and unlock it. If “Trust This Computer?” appears, tap “Trust” and enter your passcode. Please connect only this one iPhone. {App} only reads a few details now. Nothing on the iPhone is changed."
          }
        }
      }
    },
