    "s07.item.1" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installieren Sie Threema aus dem App Store (die normale App, nicht Threema Work)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install Threema from the App Store (the regular app, not Threema Work)."
          }
        }
      }
    },
    "s07.item.2" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim ersten Start: „Backup wiederherstellen“ → „Threema Safe“. Threema-ID und Safe-Passwort eingeben. Ab jetzt gehört Ihre ID dem iPhone; auf dem Android-Handy funktioniert Threema danach nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On first launch: “Restore backup” → “Threema Safe”. Enter your Threema ID and Safe password. From now on your ID belongs to the iPhone; Threema stops working on the Android phone."
          }
        }
      }
    },
    "s07.item.3" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einrichtung abschließen und Threema einmal öffnen, bis die Chatliste zu sehen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish the setup and open Threema once until you see the chat list."
          }
        }
      }
    },
    "s07.item.4" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Threema: Einstellungen → „Nachrichten behalten“ → „Für immer“. Wichtig: Sonst löscht Threema die übertragenen alten Nachrichten wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Threema: Settings → “Keep messages” → “Forever”. Important: otherwise Threema deletes the transferred old messages again."
          }
        }
      }
    },
    "s07.item.5" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie in Threema die Personen aus der Liste als Kontakt hinzu (Kontakte → +). Sonst fehlen Gruppennachrichten von ihnen (Personen: {k}, Nachrichten: {m})."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Threema, add the people on the list as contacts (Contacts → +). Otherwise group messages from them will be missing (people: {k}, messages: {m})."
          }
        }
      }
    },
