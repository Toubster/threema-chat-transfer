    "pw_help.after" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfen Sie danach, ob die automatischen Updates noch aus sind (Schritt „iPhone-Einstellungen“). Klicken Sie dann auf **Erneut prüfen**: Ist das Sicherungs-Passwort weg, legt {App} ein neues fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afterwards check that automatic updates are still off (step “iPhone settings”). Then click **Check again**: once the backup password is gone, {App} sets a new one."
          }
        }
      }
    },
    "pw_help.checking" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr iPhone wird geprüft …"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking your iPhone …"
          }
        }
      }
    },
    "pw_help.finder_net" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Finder-Sicherung aus dem Schritt „Sicherheitsnetz bei Apple“ ist mit dem alten Passwort verschlüsselt. Machen Sie nach dem Zurücksetzen zusätzlich ein iCloud-Backup als Sicherheitsnetz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Finder backup from the step “Apple safety net” is encrypted with the old password. After the reset, also make an iCloud backup as your safety net."
          }
        }
      }
    },
    "pw_help.link" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwort unbekannt? So kommen Sie weiter"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't know the password? Here is how to go on"
          }
        }
      }
    },
    "pw_help.step1" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Frühere Passwörter probieren**, etwa Ihr damaliges Mac- oder iTunes-Passwort. Ein falsches meldet die App nach wenigen Minuten; am iPhone ändert sich dabei nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Try passwords you used back then**, for example your old Mac or iTunes password. The app reports a wrong one within a few minutes; nothing on the iPhone changes."
          }
        }
      }
    },
    "pw_help.step2" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Auf diesem Mac suchen** (oder auf dem Mac, mit dem Sie damals gesichert haben): In der **Schlüsselbundverwaltung** (Spotlight: „Schlüsselbund“) oder der App „Passwörter“ nach „Backup“ suchen. Der Eintrag heißt oft „iOS Backup“ oder „iPhone Backup“; diese Namen stammen aus Erfahrungsberichten und sind nicht auf jeder macOS-Version geprüft. Hat {App} das Passwort erzeugt: „{App} – Backup-Passwort“. Doppelklick → „Passwort einblenden“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Search this Mac** (or the Mac you used for backups back then): in **Keychain Access** (Spotlight: “Keychain”) or the Passwords app, search for “backup”. The item is often called “iOS Backup” or “iPhone Backup”; these names come from user reports and are not checked on every macOS version. If {App} created the password: “{App} – Backup-Passwort”. Double-click → “Show password”."
          }
        }
      }
    },
    "pw_help.step3" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Wenn nichts hilft – Apples offizieller Weg:** Am iPhone Einstellungen → Allgemein → iPhone übertragen/zurücksetzen → Zurücksetzen → „Alle Einstellungen zurücksetzen“. Chats, Fotos, Apps und andere Daten bleiben erhalten. WLAN-Passwörter, Hintergrundbild, Apple-Pay-Karten und einige Einstellungen werden zurückgesetzt. Danach ist das Sicherungs-Passwort weg; ältere Sicherungen öffnen sich weiterhin nur mit dem alten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**If nothing helps – Apple's official way:** on the iPhone, Settings → General → Transfer or Reset iPhone → Reset → “Reset All Settings”. Chats, photos, apps and other data stay. Wi-Fi passwords, wallpaper, Apple Pay cards and some settings are reset. Afterwards the backup password is gone; older backups still open only with the old one."
          }
        }
      }
    },
    "pw_help.still_on" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr iPhone hat noch ein Sicherungs-Passwort. Ist „Alle Einstellungen zurücksetzen“ schon abgeschlossen? Das iPhone muss entsperrt und mit diesem Mac verbunden sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone still has a backup password. Has “Reset All Settings” finished? The iPhone must be unlocked and connected to this Mac."
          }
        }
      }
    },
    "pw_help.why" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Warum ist es an, obwohl Sie sich an nichts erinnern?** Meist wurde es vor Jahren in iTunes oder im Finder („Lokales Backup verschlüsseln“) oder mit einem anderen iPhone-Programm festgelegt. Die Einstellung kann beim Wechsel auf ein neues iPhone mitkommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Why is it on although you don't remember setting it?** Usually it was set years ago in iTunes or Finder (“Encrypt local backup”) or with another iPhone program. The setting can move along to a new iPhone."
          }
        }
      }
    },
    "pwprompt.rejected" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort, das {App} hatte, passt nicht. Haben Sie die Verschlüsselung im Finder eingeschaltet, ist es das Passwort, das Sie dort gewählt haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password {App} had does not match. If you turned on encryption in Finder, it is the password you chose there."
          }
        }
      }
    },
    "pwprompt.text" : {
      "comment" : "app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit {App} weitermachen kann, geben Sie bitte das Passwort für iPhone-Sicherungen auf dem Mac noch einmal ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To continue, {App} needs the password for iPhone backups on the Mac again."
          }
        }
      }
    },
    "pwprompt.title" : {
      "comment" : "app",
