#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# commit-msg: the message itself goes through the privacy scan (DESIGN §10.3 "Commit-Messages").
ROOT="$(git rev-parse --show-toplevel)" || exit 1
PY="$ROOT/.venv/bin/python"; [ -x "$PY" ] || PY="python3"
exec "$PY" "$ROOT/scripts/scrub_check.py" --root "$ROOT" --text-stdin commit-message < "$1"
